   "source": [
    "# 07 - Power BI Dashboard Preparation\n",
    "\n",
    "Prepare datasets and DAX measures for Power BI dashboard. Export clean data with predictions and create DAX measure definitions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Setup\n",
    "import sys\n",
    "sys.path.append('../')\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import joblib\n",
    "\n",
    "from src.data.preprocessing import load_processed_data\n",
    "from src.data.ingestion import load_raw_data\n",
    "from src.models.predict import load_model, load_scaler, batch_predict\n",
    "from src.config import DATA_PROCESSED, DATA_RAW, POWERBI_DIR, MODELS_DIR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Data\n",
    "raw_df = load_raw_data()\n",
    "print(f\"Raw data: {raw_df.shape}\")\n",
    "\n",
    "# Load best model and scaler\n",
    "model = load_model('best_model')\n",
    "scaler = load_scaler()\n",
    "\n",
    "# Load feature names from training\n",
    "X_train = pd.read_csv(DATA_PROCESSED / 'X_train.csv')\n",
    "feature_names = X_train.columns.tolist()\n",
    "\n",
    "print(f\"Model: {type(model).__name__}\")\n",
    "print(f\"Features: {len(feature_names)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare Full Dataset for Power BI\n",
    "print(\"=== Preparing Full Dataset ===\")\n",
    "\n",
    "# Use raw data with engineered features\n",
    "from src.data.feature_engineering import create_all_features\n",
    "\n",
    "df_powerbi = raw_df.copy()\n",
    "df_powerbi = create_all_features(df_powerbi)\n",
    "\n",
    "# Prepare features for prediction\n",
    "drop_cols = ['id', 'date', 'price', 'price_per_sqft', 'age_band']\n",
    "drop_cols = [c for c in drop_cols if c in df_powerbi.columns]\n",
    "\n",
    "X = df_powerbi.drop(columns=drop_cols)\n",
    "\n",
    "# Handle categorical columns\n",
    "cat_cols = X.select_dtypes(include=['object']).columns\n",
    "if len(cat_cols) > 0:\n",
    "    X = pd.get_dummies(X, columns=cat_cols, drop_first=True)\n",
    "\n",
    "# Align with training features\n",
    "X = X.reindex(columns=feature_names, fill_value=0)\n",
    "\n",
    "# Scale and predict\n",
    "X_scaled = scaler.transform(X)\n",
    "predictions = model.predict(X_scaled)\n",
    "\n",
    "# Add predictions to dataframe\n",
    "df_powerbi['predicted_price'] = predictions\n",
    "df_powerbi['residual'] = df_powerbi['price'] - df_powerbi['predicted_price']\n",
    "df_powerbi['abs_error'] = np.abs(df_powerbi['residual'])\n",
    "df_powerbi['pct_error'] = (df_powerbi['abs_error'] / df_powerbi['price']) * 100\n",
    "df_powerbi['prediction_accurate_10'] = (df_powerbi['pct_error'] <= 10).astype(int)\n",
    "df_powerbi['prediction_accurate_20'] = (df_powerbi['pct_error'] <= 20).astype(int)\n",
    "\n",
    "print(f\"Power BI dataset shape: {df_powerbi.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Select and Order Columns for Power BI\n",
    "powerbi_cols = [\n",
    "    'id', 'date', 'price', 'predicted_price', 'residual', 'abs_error', 'pct_error',\n",
    "    'prediction_accurate_10', 'prediction_accurate_20',\n",
    "    'bedrooms', 'bathrooms', 'sqft_living', 'sqft_lot', 'floors',\n",
    "    'waterfront', 'view', 'condition', 'grade', 'sqft_above', 'sqft_basement',\n",
    "    'yr_built', 'yr_renovated', 'zipcode', 'lat', 'long',\n",
    "    'sqft_living15', 'sqft_lot15',\n",
    "    'sale_year', 'sale_month', 'sale_quarter', 'sale_dayofweek',\n",
    "    'price_per_sqft', 'age', 'is_renovated', 'age_band',\n",
    "    'amenity_count', 'has_basement', 'living_ratio',\n",
    "    'zipcode_freq', 'dist_to_seattle_center'\n",
    "]\n",
    "\n",
    "# Keep only columns that exist\n",
    "powerbi_cols = [c for c in powerbi_cols if c in df_powerbi.columns]\n",
    "df_powerbi = df_powerbi[powerbi_cols]\n",
    "\n",
    "# Ensure date is datetime\n",
    "df_powerbi['date'] = pd.to_datetime(df_powerbi['date'])\n",
    "\n",
    print(df_powerbi.dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export for Power BI\n",
    "output_path = DATA_PROCESSED / 'kc_house_for_powerbi.csv'\n",
    "df_powerbi.to_csv(output_path, index=False)\n",
    "print(f\"Exported to: {output_path}\")\n",
    "print(f\"Shape: {df_powerbi.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate DAX Measures\n",
    "print(\"=== Generating DAX Measures ===\")\n",
    "\n",
    "dax_measures = '''\n",
    "-- ============================================\n",
    "-- REAL ESTATE PRICE INTELLIGENCE - DAX MEASURES\n",
    "-- ============================================\n",
    "\n",
    "-- 1. BASIC PRICE MEASURES\n",
    "Average Price = AVERAGE('kc_house_for_powerbi'[price])\n",
    "Median Price = MEDIAN('kc_house_for_powerbi'[price])\n",
    "Min Price = MIN('kc_house_for_powerbi'[price])\n",
    "Max Price = MAX('kc_house_for_powerbi'[price])\n",
    "Price StdDev = STDEV.P('kc_house_for_powerbi'[price])\n",
    "Total Properties = COUNTROWS('kc_house_for_powerbi')\n",
    "\n",
    "-- 2. PRICE PER SQFT MEASURES\n",
    "Avg Price Per SqFt = AVERAGE('kc_house_for_powerbi'[price_per_sqft])\n",
    "Median Price Per SqFt = MEDIAN('kc_house_for_powerbi'[price_per_sqft])\n",
    "Price Per SqFt StdDev = STDEV.P('kc_house_for_powerbi'[price_per_sqft])\n",
    "\n",
    "-- 3. PREDICTION ACCURACY MEASURES\n",
    "Avg Prediction Error = AVERAGE('kc_house_for_powerbi'[abs_error])\n",
    "Median Prediction Error = MEDIAN('kc_house_for_powerbi'[abs_error])\n",
    "MAPE = AVERAGE('kc_house_for_powerbi'[pct_error])\n",
    "Accuracy Within 10% = DIVIDE(\n",
    "    CALCULATE(COUNTROWS('kc_house_for_powerbi'), 'kc_house_for_powerbi'[prediction_accurate_10] = 1),\n",
    "    COUNTROWS('kc_house_for_powerbi')\n",
    ")\n",
    "Accuracy Within 20% = DIVIDE(\n",
    "    CALCULATE(COUNTROWS('kc_house_for_powerbi'), 'kc_house_for_powerbi'[prediction_accurate_20] = 1),\n",
    "    COUNTROWS('kc_house_for_powerbi')\n",
    ")\n",
    "RMSE = SQRT(AVERAGEX('kc_house_for_powerbi', 'kc_house_for_powerbi'[residual]^2))\n",
    "MAE = AVERAGE('kc_house_for_powerbi'[abs_error])\n",
    "R_Squared = 1 - DIVIDE(\n",
    "    SUMX('kc_house_for_powerbi', 'kc_house_for_powerbi'[residual]^2),\n",
    "    SUMX('kc_house_for_powerbi', ('kc_house_for_powerbi'[price] - AVERAGE('kc_house_for_powerbi'[price]))^2)\n",
    ")\n",
    "\n",
    "-- 4. PRICE BY CATEGORY MEASURES\n",
    "Avg Price by Zipcode = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[zipcode]))\n",
    "Median Price by Zipcode = CALCULATE([Median Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[zipcode]))\n",
    "Property Count by Zipcode = CALCULATE([Total Properties], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[zipcode]))\n",
    "\n",
    "Avg Price by Bedrooms = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[bedrooms]))\n",
    "Avg Price by Bathrooms = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[bathrooms]))\n",
    "Avg Price by Condition = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[condition]))\n",
    "Avg Price by Grade = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[grade]))\n",
    "Avg Price by Waterfront = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[waterfront]))\n",
    "Avg Price by View = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[view]))\n",
    "Avg Price by Age Band = CALCULATE([Average Price], ALLEXCEPT('kc_house_for_powerbi', 'kc_house_for_powerbi'[age_band]))\n",
    "\n",
    "-- 5. TIME INTELLIGENCE MEASURES\n",
    "Avg Price YoY = \n",
    "VAR CurrentYear = MAX('kc_house_for_powerbi'[sale_year])\n",
    "VAR PriorYear = CurrentYear - 1\n",
    "RETURN\n",
    "    CALCULATE(\n",
    "        [Average Price],\n",
    "        'kc_house_for_powerbi'[sale_year] = PriorYear\n",
    "    )\n",
    "\n",
    "Price YoY Change % = DIVIDE([Average Price] - [Avg Price YoY], [Avg Price YoY])\n",
    "\n",
    "Avg Price QoQ = \n",
    "VAR CurrentQuarter = MAX('kc_house_for_powerbi'[sale_quarter])\n",
    "VAR CurrentYear = MAX('kc_house_for_powerbi'[sale_year])\n",
    "VAR PriorQuarter = IF(CurrentQuarter = 1, 4, CurrentQuarter - 1)\n",
    "VAR PriorYear = IF(CurrentQuarter = 1, CurrentYear - 1, CurrentYear)\n",
    "RETURN\n",
    "    CALCULATE(\n",
    "        [Average Price],\n",
    "        'kc_house_for_powerbi'[sale_year] = PriorYear,\n",
    "        'kc_house_for_powerbi'[sale_quarter] = PriorQuarter\n",
    "    )\n",
    "\n",
    "Price QoQ Change % = DIVIDE([Average Price] - [Avg Price QoQ], [Avg Price QoQ])\n",
    "\n",
    "-- 6. PROPERTY CHARACTERISTICS\n",
    "Avg SqFt Living = AVERAGE('kc_house_for_powerbi'[sqft_living])\n",
    "Avg Lot Size = AVERAGE('kc_house_for_powerbi'[sqft_lot])\n",
    "Avg Bedrooms = AVERAGE('kc_house_for_powerbi'[bedrooms])\n",
    "Avg Bathrooms = AVERAGE('kc_house_for_powerbi'[bathrooms])\n",
    "Avg Property Age = AVERAGE('kc_house_for_powerbi'[age])\n",
    "% Waterfront = DIVIDE(\n",
    "    CALCULATE(COUNTROWS('kc_house_for_powerbi'), 'kc_house_for_powerbi'[waterfront] = 1),\n",
    "    COUNTROWS('kc_house_for_powerbi')\n",
    ")\n",
    "% Renovated = DIVIDE(\n",
    "    CALCULATE(COUNTROWS('kc_house_for_powerbi'), 'kc_house_for_powerbi'[is_renovated] = 1),\n",
    "    COUNTROWS('kc_house_for_powerbi')\n",
    ")\n",
    "% With Basement = DIVIDE(\n",
    "    CALCULATE(COUNTROWS('kc_house_for_powerbi'), 'kc_house_for_powerbi'[has_basement] = 1),\n",
    "    COUNTROWS('kc_house_for_powerbi')\n",
    ")\n",
    "\n",
    "-- 7. MARKET SEGMENTATION\n",
    "Luxury Properties = CALCULATE(\n",
    "    [Total Properties],\n",
    "    'kc_house_for_powerbi'[price] >= PERCENTILEX.INC('kc_house_for_powerbi', 'kc_house_for_powerbi'[price], 0.9)\n",
    ")\n",
    "Affordable Properties = CALCULATE(\n",
    "    [Total Properties],\n",
    "    'kc_house_for_powerbi'[price] <= PERCENTILEX.INC('kc_house_for_powerbi', 'kc_house_for_powerbi'[price], 0.25)\n",
    ")\n",
    "Mid-Range Properties = [Total Properties] - [Luxury Properties] - [Affordable Properties]\n",
    "\n",
    "-- 8. PREDICTION INTERVAL MEASURES\n",
    "Prediction Interval Width 95 = 1.96 * [RMSE]\n",
    "Prediction Interval Width 80 = 1.28 * [RMSE]\n",
    "\n",
    "Lower Bound 95 = [Average Price] - [Prediction Interval Width 95]\n",
    "Upper Bound 95 = [Average Price] + [Prediction Interval Width 95]\n",
    "\n",
    "-- 9. FEATURE IMPORTANCE (if available as table)\n",
    "-- Feature Importance Rank = RANKX(ALL('FeatureImportance'), 'FeatureImportance'[Importance],,DESC,Dense)\n",
    "\n",
    "-- 10. CONDITIONAL FORMATTING HELPERS\n",
    "Price Color = \n",
    "SWITCH(\n",
    "    TRUE(),\n",
    "    [Average Price] >= 1000000, \"#8B0000\",\n",
    "    [Average Price] >= 750000, \"#FF4500\",\n",
    "    [Average Price] >= 500000, \"#FFA500\",\n",
    "    [Average Price] >= 350000, \"#FFD700\",\n",
    "    \"#32CD32\"\n",
    ")\n",
    "\n",
    "Error Color = \n",
    "SWITCH(\n",
    "    TRUE(),\n",
    "    [MAPE] >= 30, \"#8B0000\",\n",
    "    [MAPE] >= 20, \"#FF4500\",\n",
    "    [MAPE] >= 15, \"#FFA500\",\n",
    "    [MAPE] >= 10, \"#FFD700\",\n",
    "    \"#32CD32\"\n",
    ")\n",
    "'''\n",
    "\n",
    "# Save DAX measures\n",
    "dax_path = POWERBI_DIR / 'dax_measures.txt'\n",
    "with open(dax_path, 'w') as f:\n",
    "    f.write(dax_measures)\n",
    "\n",
    "print(f\"DAX measures saved to: {dax_path}\")"
   ]
  },

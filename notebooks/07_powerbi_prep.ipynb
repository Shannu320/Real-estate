    "# Generate Model Performance Summary for Power BI\n",
    "print(\"=== Model Performance Summary ===\")\n",
    "\n",
    "from src.models.train import load_training_results\n",
    "\n",
    "results = load_training_results()\n",
    "\n",
    "model_perf = []\n",
    "for name, result in results.items():\n",
    "    if 'error' in result:\n",
    "        continue\n",
    "    test_m = result['test_metrics']\n",
    "    cv = result['cv_results']\n",
    "    model_perf.append({\n",
    "        'model': name,\n",
    "        'test_MAE': test_m['MAE'],\n",
    "        'test_RMSE': test_m['RMSE'],\n",
    "        'test_R2': test_m['R2'],\n",
    "        'test_MAPE': test_m['MAPE'],\n",
    "        'cv_RMSE_mean': cv['cv_rmse_mean'],\n",
    "        'cv_RMSE_std': cv['cv_rmse_std']\n",
    "    })\n",
    "\n",
    "perf_df = pd.DataFrame(model_perf).sort_values('test_RMSE')\n",
    "perf_path = POWERBI_DIR / 'model_performance.csv'\n",
    "perf_df.to_csv(perf_path, index=False)\n",
    "print(f\"Model performance saved to: {perf_path}\")\n",
    "display(perf_df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate Feature Importance for Power BI\n",
    "print(\"=== Feature Importance ===\")\n",
    "\n",
    "from src.models.train import get_feature_importance\n",
    "\n",
    "X_train = pd.read_csv(DATA_PROCESSED / 'X_train.csv')\n",
    "feature_names = X_train.columns.tolist()\n",
    "\n",
    "importance_data = []\n",
    "for name, result in results.items():\n",
    "    if 'error' in result:\n",
    "        continue\n",
    "    model = result['model']\n",
    "    imp_df = get_feature_importance(model, feature_names)\n",
    "    imp_df['model'] = name\n",
    "    importance_data.append(imp_df)\n",
    "\n",
    "if importance_data:\n",
    "    combined_imp = pd.concat(importance_data, ignore_index=True)\n",
    "    imp_path = POWERBI_DIR / 'feature_importance.csv'\n",
    "    combined_imp.to_csv(imp_path, index=False)\n",
    "    print(f\"Feature importance saved to: {imp_path}\")"
   ]
